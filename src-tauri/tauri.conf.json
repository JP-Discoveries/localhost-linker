{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localhost Linker",
  "version": "0.1.1",
  "identifier": "dev.localhostlinker.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Localhost Linker",
        "width": 320,
        "height": 480,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Turns local dev servers into phone-scannable QR codes",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
